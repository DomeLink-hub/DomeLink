# ── Server ───────────────────────────────────────────────────
# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────
# 64-character hex secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=your_64_char_hex_secret_here

# JWT access token lifetime (e.g. 7d, 2d, 1h)
JWT_EXPIRES_IN=7d

# ── Database (Postgres via Prisma) ───────────────────────────
# Pooler connection URL (used by Prisma at runtime with pgBouncer)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true

# Direct connection URL (used by Prisma Migrate — bypasses pgBouncer)
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ── MongoDB (Mongoose — blog, support, project-brief, team, styleQuiz, analytics events) ──
# Atlas connection string — required for these features to work
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp

# ── Frontend ─────────────────────────────────────────────────
# Exact frontend origin — used for CORS (Express + Socket.io) and email links
FRONTEND_URL=http://localhost:8080

# ── Cloudinary (file uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional folder prefix for all DomeLink uploads in Cloudinary
CLOUDINARY_UPLOAD_FOLDER=domelink

# ── Razorpay (payments) ──────────────────────────────────────
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook signing secret — set in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Email (Resend) ───────────────────────────────────────────
# API key from resend.com — used for verification and password reset emails
RESEND_API_KEY=re_your_resend_api_key_here

# From address shown in outgoing emails
EMAIL_FROM=DomeLink <noreply@yourdomain.com>

# ── AI (GROQ) ────────────────────────────────────────────────
# API key from console.groq.com — used for Avora AI features
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Error Monitoring (Sentry) ────────────────────────────────
# DSN from sentry.io — leave blank to disable Sentry
SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project_id
